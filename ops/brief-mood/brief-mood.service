[Unit]
Description=Brief Mood cockpit
After=network-online.target

[Service]
User=ivt
Group=ivt
WorkingDirectory=/opt/brief-mood
EnvironmentFile=/etc/brief-mood.env
Environment=HOME=/opt/ivt-radar
Environment=CODEX_HOME=/var/lib/ivt-radar/codex
Environment=PATH=/opt/ivt-radar-tools/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Europe/Paris
ExecStart=/opt/ivt-radar/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8790 --workers 1 --no-access-log
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/brief-mood /var/lib/ivt-radar/codex /opt/ivt-radar/.config
MemoryMax=1400M
CPUQuota=150%

[Install]
WantedBy=multi-user.target
